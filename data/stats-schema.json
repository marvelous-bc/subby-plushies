{
  "schemaVersion": 1,
  "pluginVersion": "2.3.7.17",
  "storageKey": "SubbysPlushies:stats:v1",
  "battleStorage": "per-account",
  "fields": {
    "totalInteractions": "number",
    "actions": "object<string,number>",
    "plushesUsed": "object<string,number>",
    "speechBubbles": "number",
    "idleAnimations": "number",
    "mascotSets": "number",
    "drags": "number",
    "offers": "number",
    "progress": "object (achievement/stat progress; rooms, players, offer successes, streaks, Protect count, interaction days, resize flags, etc.)",
    "achievements": "object<achievementId,timestampMs>"
  },
  "progressHighlights": {
    "roomsVisited": "object<roomName,1>",
    "playersInteracted": "object<memberNumber,1>",
    "interactionDays": "object<plushName,{count:number,lastDay:YYYY-MM-DD}> (legacy date maps migrate lazily)",
    "bonkedPlushies": "object<plushName,1>",
    "successfulOffers": "number",
    "bestBattleWinStreak": "number",
    "currentBattleWinStreak": "number",
    "photoFinishWins": "number",
    "protectTriggers": "number",
    "balanceBestSeconds": "number",
    "baseCuddleSubbycat": "0|1",
    "tinyPlushie": "0|1",
    "absoluteUnit": "0|1"
  },
  "battleFields": {
    "played": "number",
    "wins": "number",
    "losses": "number",
    "draws": "number"
  },
  "note": "General stats remain local. Performance-sensitive progress writes are deferred/batched; interaction-day tracking uses a compact count/last-day record. Battle stats/history remain stored per Bondage Club account member number."
}
